crates/ibi-correct/tests/vectors/real_*.json

# Real-data golden vectors (captured from the personal DB): local-only.
# Regenerate with tools/nssa_plumbing_golden.py. Tests SKIP without them.
crates/nssa-plumbing/tests/vectors/
crates/oura-models/tests/vectors/

